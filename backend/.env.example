# ==============================================================================
# SkillCraftAI Backend Environment Configuration
# ==============================================================================

# --- Server Settings ---
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Supabase Configuration (PostgreSQL, Auth & Storage) ---
# Project URL: Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Anon Key: Public key for client/server read operations
SUPABASE_KEY=your-supabase-anon-key
# Service Role Key: Secret key for administrative actions (bypass RLS for server ops)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# JWT Secret: Found in Supabase Dashboard -> Project Settings -> API -> JWT Settings
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Supabase Storage bucket for resume files
SUPABASE_STORAGE_BUCKET_RESUMES=resumes

# --- Microsoft Foundry & Foundry Agent Service ---
# Endpoint for your Azure AI Foundry / Azure OpenAI service
AZURE_FOUNDRY_ENDPOINT=https://your-foundry-resource.services.ai.azure.com
AZURE_FOUNDRY_API_KEY=your-foundry-api-key
# Foundry Project Connection String (e.g. <region>.api.azureml.ms;<subscription_id>;<resource_group>;<project_name>)
AZURE_FOUNDRY_PROJECT_CONNECTION_STRING=
AZURE_OPENAI_DEPLOYMENT_NAME=GPT-4.1-mini
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# --- Azure AI Search (RAG) ---
# URL for your Azure Cognitive / AI Search resource
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your-azure-search-admin-key
AZURE_SEARCH_INDEX_NAME=skillcraft-rag-index
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Azure AI Speech (Voice: STT & TTS) ---
# Key and region for Azure Speech Services
AZURE_SPEECH_KEY=your-azure-speech-resource-key
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE_NAME=en-US-JennyNeural

# --- Judge0 Code Execution ---
JUDGE0_URL=https://ce.judge0.com
